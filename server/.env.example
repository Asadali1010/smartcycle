# Copy to `.env` for local development ONLY. Never commit a real `.env` file,
# and never put real values here — this file holds placeholder names only.
#
# Nothing in server/src/index.ts currently reads these to make a real LLM
# call (see the TODO in that file) — they're reserved for when this stub is
# actually wired to a live backend.

# Port the stub Express server listens on.
PORT=8787

# Placeholder for a future LLM provider key. NEVER embed this in any
# client-side code/bundle — it must only ever be read via process.env on
# this server.
CHATBOT_LLM_API_KEY=

# Placeholder for a future LLM provider base URL.
CHATBOT_LLM_BASE_URL=
